# Copy this file to .env for local testing (netlify dev) and never commit the real .env.
# In production, set these same names as Environment Variables in the Netlify dashboard
# (Site settings -> Environment variables) -- do not put real secrets in this file.

# Gmail account that sends the feedback email (needs a Gmail App Password, not your normal password)
# Create one at https://myaccount.google.com/apppasswords (requires 2FA enabled on the account)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password

# Where the feedback email should be delivered (usually the same as EMAIL_USER, but can differ)
FEEDBACK_TO_EMAIL=csmfastforward@gmail.com

# --- WhatsApp notification (optional but recommended) ---
# Uses CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/), which is free
# and needs no business verification. One-time setup, done from the CLIENT's WhatsApp number:
#   1. Save +34 644 84 71 64 as a contact on the client's phone.
#   2. From that phone, WhatsApp the contact: "I allow callmebot to send me messages"
#   3. CallMeBot replies with an API key. Put that number + key below.
# If these two vars are left blank, the survey still works -- it just skips the WhatsApp ping.
WHATSAPP_PHONE=2348136033584
WHATSAPP_APIKEY=your-callmebot-api-key
